# ===========================================================================
# WakuFlow Assist - Phase 1 (receive -> classify -> ticket to LINE group)
# Copy this file to `.env` and fill the blanks. NEVER commit the real `.env`.
# While a value is blank, that capability stays off (no crash): signature checks
# fail closed and ticket delivery runs in dry-run.
# ===========================================================================

# ---- Facebook / Meta (Messenger) ----
FB_APP_SECRET=          # App -> Settings -> Basic (verify X-Hub-Signature-256)
FB_PAGE_TOKEN=          # Page Access Token  (⚠️ convert to a PERMANENT page token)
FB_PAGE_ID=             # numeric page id
FB_VERIFY_TOKEN=        # any string you choose; must match the Meta webhook setup

# ---- LINE (Official Account / Messaging API) ----
LINE_CHANNEL_SECRET=        # Developers Console -> Basic settings (verify x-line-signature)
LINE_CHANNEL_ACCESS_TOKEN=  # Developers Console -> Messaging API (long-lived)
LINE_TARGET_GROUP_ID=       # the staff LINE group that receives the tickets

# ---- engine / runtime ----
ASSIST_HMAC_SECRET=         # >= 32 characters, random; internal digests (keep secret)
ASSIST_TENANT_ID=tulip
ASSIST_DB_PATH=data/assist.db
KB_APPROVED_PATH=phase6/config/approved_kb.json
KB_DRAFT_PATH=phase6/config/kb_draft_from_research.json
