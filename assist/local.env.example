# Copy this file to local.env and edit the values. No spaces around the = sign.
# local.env holds secrets: never share it, never commit it.
# --- Facebook page (Messenger). Only these two are needed to RECEIVE messages. ---
FB_APP_SECRET=test-secret
FB_VERIFY_TOKEN=test-verify-token
# FB_PAGE_ID=        # only used for display/readiness
# FB_PAGE_TOKEN=     # only needed later, to SEND

# --- LINE (leave blank if you have no LINE official account) ---
LINE_CHANNEL_SECRET=
ASSIST_HMAC_SECRET=replace-with-32-or-more-random-english-letters-and-digits
ASSIST_STORE_TEXT=1
ASSIST_EXPORT_PASSWORD=mypass123
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_GROUP_ID=
PORT=8080

# Public policy pages (/privacy, /data-deletion) - needed for Meta App Review. Blank = pages off.
# ASSIST_COMPANY_NAME=
# ASSIST_CONTACT_EMAIL=
